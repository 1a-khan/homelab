# Machine-specific Ansible configuration
ansible/*.ini
!ansible/*.example.ini
ansible/group_vars/*.yml
!ansible/group_vars/*.example.yml
ansible/host_vars/

# Operational evidence may contain host details, logs and vulnerabilities
security-reports/
maintenance-reports/
*.log
*.sql
*.sql.gz
*.dump
*.snapshot
*.qcow2
*.vmdk
*.iso

# Local credentials and private portfolio material
.secrets/
secrets/
private/
