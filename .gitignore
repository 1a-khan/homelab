.terraform.lock.hcl

# Ansible local/runtime files
ansible/inventory.ini
ansible/hetzner-staging.ini
ansible/group_vars/all.yml
ansible/*.retry

# kubeconfig copied from the server
kubeconfig

# Local tool downloads
tools/downloads/
tools/bin/

# Python generated files
__pycache__/
*.py[cod]

# Environment overrides and credentials (keep sanitized examples)
.env.*
!.env.example
!.env.*.example
*.tfvars.json
*.auto.tfvars.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
